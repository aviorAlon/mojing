# Copy to .env (scripts/setup.py does this for you) and adjust. Real environment variables override this file.

# ---- Web / try-on service ----
TRYON_HOST=127.0.0.1          # 0.0.0.0 to reach it from other machines (no auth: only on trusted networks)
TRYON_PORT=7860
TRYON_ENGINE=on               # off = start without loading the try-on model (UI/API only, no GPU needed)
FASHN_WEIGHTS=models/fashn    # where scripts/setup.py puts the FASHN VTON v1.5 weights

# ---- laya decision service ----
LAYA_HOST=127.0.0.1
LAYA_PORT=8765
LAYA_DEVICE=cpu               # cpu is enough (0.2-0.4 s per decision); cuda competes with try-on for VRAM

# ---- Data locations (relative to the project root) ----
DATA_DIR=data                 # uploaded people, results, logs
CATALOG_DIR=catalog           # garment listings
SAMPLES_DIR=samples/persons   # bundled read-only sample people

# ---- Hugging Face ----
# HF_ENDPOINT=https://hf-mirror.com   # mirror for mainland China
# HF_TOKEN=                           # optional, raises download rate limits

# ---- Generation models (optional; nothing is configured by default, see docs/generation.md) ----
# Images, used by tools/generate_catalog.py and tools/generate_person.py: any OpenAI-compatible Images API
# IMAGE_API_BASE=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1536
# IMAGE_PROVIDER=my_image:MyImageProvider   # or your own class in plugins/
# Turnaround video on the website: your own class in plugins/
# VIDEO_PROVIDER=my_video:MyVideoProvider
# VIDEO_SECONDS=5
